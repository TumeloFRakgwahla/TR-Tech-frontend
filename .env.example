# Local development: relative path is proxied to the backend via the Vite dev server
# (see server.proxy in vite.config.js -> http://localhost:5000).
VITE_API_URL=/api/v1

# Production (Vercel): use the absolute backend URL so the SPA can reach the
# tr-tech-backend service directly (the backend is CORS-enabled for this origin).
# This value is also baked in by vercel.json -> env.VITE_API_URL and can be
# overridden in the Vercel project settings if the backend domain changes.
# VITE_API_URL=https://api.trtech.co.za/api/v1

VITE_WHATSAPP_NUMBER=27791002552
