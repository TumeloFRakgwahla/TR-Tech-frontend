# Local development: relative path is proxied to the backend via the Vite dev server
# (see server.proxy in vite.config.js -> http://localhost:5000).
VITE_API_URL=/api/v1

# Production (Vercel): the SPA is served same-origin and all /api and /uploads requests
# are reverse-proxied to the tr-tech-backend service by vercel.json (server-side). The
# backend URL therefore stays on Vercel's edge and is NEVER exposed to the browser, so no
# public VITE_* variable is required. The proxy target lives only in vercel.json rewrites.
# If you prefer an explicit absolute URL instead of the proxy, set VITE_API_URL to e.g.
# https://api.trtech.co.za/api/v1 (note: VITE_-prefixed values are inlined into the client).

VITE_WHATSAPP_NUMBER=27791002552
